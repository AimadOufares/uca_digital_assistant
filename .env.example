APP_ENV=local
DJANGO_DEBUG=true
SECRET_KEY=change-me-for-production
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=sqlite:///db.sqlite3

RAG_DATA_ROOT=data_storage
RAG_RAW_DIR=data_storage/raw
RAG_RAW_MAIN_DIR=data_storage/raw/main
RAG_RAW_ARCHIVE_DIR=data_storage/raw/archive
RAG_RAW_DRIVE_DIR=data_storage/raw/drive
RAG_PROCESSED_DIR=data_storage/processed
RAG_PROCESSED_MAIN_DIR=data_storage/processed/main
RAG_PROCESSED_ARCHIVE_DIR=data_storage/processed/archive
RAG_PROCESSED_DRIVE_DIR=data_storage/processed/drive
RAG_INDEX_DIR=data_storage/index
RAG_INDEX_MAIN_DIR=data_storage/index/main
RAG_INDEX_ARCHIVE_DIR=data_storage/index/archive
RAG_CACHE_DIR=data_storage/cache
RAG_INGESTION_STATE_DIR=data_storage/cache/ingestion
RAG_REPORTS_DIR=data_storage/reports
RAG_BACKUPS_DIR=data_storage/backups
RAG_LOCKS_DIR=data_storage/locks
RAG_QUARANTINE_DIR=data_storage/quarantine

RAG_VECTOR_BACKEND=faiss
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_QDRANT_URL=
RAG_QDRANT_API_KEY=
RAG_QDRANT_COLLECTION_PREFIX=uca_kb
RAG_ACTIVE_INDEX_NAME=uca_kb_active
RAG_INDEX_PUBLISHED_CORPORA=main,drive

RAG_LLM_PROVIDER=lmstudio
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
RAG_CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=

RAG_MAX_TOTAL_URLS=40000
RAG_MAX_DEPTH=5
RAG_INGESTION_THREADS=8
RAG_MAX_URLS_PER_DOMAIN=3500
RAG_MAX_URLS_PER_SUBDOMAIN=1200
RAG_ENABLE_SITEMAP_DISCOVERY=true
RAG_MIN_DOWNLOAD_QUALITY_SCORE=60
RAG_ENABLE_NEAR_DUP_INGESTION=true
RAG_NEAR_DUP_SIMHASH_DISTANCE=6
RAG_INCREMENTAL_FETCH=true
RAG_REFRESH_MODE=weekly
RAG_DOCUMENT_PARSER=fast
RAG_HTML_EXTRACTOR=trafilatura
RAG_PDF_EXTRACTOR=pymupdf
RAG_LANGUAGE_DETECTOR=fasttext
RAG_FASTTEXT_MODEL_PATH=data_storage/models/lid.176.bin
RAG_JS_FALLBACK_ENABLED=false
RAG_JS_RENDER_TIMEOUT_MS=12000
RAG_JS_MAX_PAGES_PER_RUN=30
RAG_JS_ALLOWED_DOMAINS=ucastudent.uca.ma,ucaplat.uca.ma,pedoc.uca.ma,cip.uca.ma,diplomes.uca.ma,e-candidature.uca.ma
RAG_PROCESSING_WORKERS=4
RAG_PROCESSING_CHECKPOINT_EVERY=25
RAG_PROCESSING_EXCLUDE_THESES=true
RAG_PROCESSING_MAX_PDF_MB=6
